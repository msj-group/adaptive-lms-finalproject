[Unit]
Description=Youth Centre Version A
After=network.target

[Service]
Type=simple
User=centre
Group=centre
WorkingDirectory=/opt/youth-centre/current
EnvironmentFile=/etc/youth-centre/production.env
ExecStart=/opt/youth-centre/venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=130
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
