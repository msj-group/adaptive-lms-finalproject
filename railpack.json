{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {"python": "3.14.6"},
  "steps": {
    "install": {
      "commands": [
        {"src": "scripts/verify_python_version.py", "dest": "scripts/verify_python_version.py"},
        "python scripts/verify_python_version.py",
        "python -m venv /app/.venv",
        {"path": "/app/.venv/bin"},
        {"src": "requirements-production.lock", "dest": "requirements-production.lock"},
        "python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements-production.lock"
      ]
    },
    "build": {
      "inputs": [
        {"step": "install"},
        {
          "local": true,
          "include": [
            "app/", "migrations/", "wsgi.py"
          ],
          "exclude": ["**/__pycache__/**", "**/*.pyc", "**/*.pyo"]
        }
      ],
      "commands": [
        {"src": "deploy/gunicorn.conf.py", "dest": "deploy/gunicorn.conf.py"},
        {"src": "scripts/create_admin.py", "dest": "scripts/create_admin.py"},
        {"src": "scripts/create_researcher.py", "dest": "scripts/create_researcher.py"},
        {"src": "scripts/research_operator.py", "dest": "scripts/research_operator.py"},
        {"src": "scripts/run_research_retention.py", "dest": "scripts/run_research_retention.py"},
        {"src": "scripts/deployment_diagnostics.py", "dest": "scripts/deployment_diagnostics.py"},
        {"src": "scripts/railway_start.py", "dest": "scripts/railway_start.py"},
        {"src": "scripts/railway_migrate.py", "dest": "scripts/railway_migrate.py"},
        {"src": "scripts/verify_python_version.py", "dest": "scripts/verify_python_version.py"}
      ]
    }
  },
  "deploy": {
    "startCommand": "python scripts/railway_start.py",
    "aptPackages": ["ca-certificates"],
    "variables": {"PYTHON_DOTENV_DISABLED": "1", "FLASK_ENV": "production"}
  }
}
