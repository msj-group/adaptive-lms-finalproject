# ==========================================================================
# Adaptive English LMS — Environment Variable Template
# Copy this file to ".env" and fill in real local values.
# NEVER commit the real ".env" file to Git.
# ==========================================================================

# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=replace-with-a-generated-secret-key

# ---- Database (MySQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=adaptive_english_lms
DATABASE_USER=replace-with-your-mysql-username
DATABASE_PASSWORD=replace-with-your-mysql-password

# ---- Application ----
APP_TIMEZONE=Africa/Tripoli
