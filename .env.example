# ==========================================================================
# Adaptive English LMS — Environment Variable Template
# Copy this file to ".env" and fill in real local values.
# NEVER commit the real ".env" file to Git.
# ==========================================================================

# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=replace-with-a-generated-secret-key

# ---- Database (MySQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=adaptive_english_lms
DATABASE_USER=replace-with-your-mysql-username
DATABASE_PASSWORD=replace-with-your-mysql-password

# ---- Application ----
APP_TIMEZONE=Africa/Tripoli

# ---- Lesson Materials (M12) ----
# MATERIAL_STORAGE_ROOT: private, non-executable file storage, outside
# app/static (never served as a public/static URL). A relative path
# resolves from the project root. Validated at start-up and fails
# closed -- see app/services/material_config.py.
MATERIAL_STORAGE_ROOT=storage/materials
# Comma-separated subset of the hard-supported extension set
# (pdf,docx,png,jpg,jpeg,gif,webp,mp3,wav,mp4,webm). May only narrow this
# set, never expand it.
MATERIAL_ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg,gif,webp,mp3,wav,mp4,webm
# Per-category maximum upload size, in bytes.
MATERIAL_MAX_DOCUMENT_BYTES=524288000
MATERIAL_MAX_IMAGE_BYTES=10485760
MATERIAL_MAX_AUDIO_BYTES=52428800
MATERIAL_MAX_VIDEO_BYTES=524288000

# ---- Online payment provider ----
# No online gateway is integrated. Only "disabled" is accepted.
# Use ordinary cash or verified bank-transfer collection forms.
PAYMENT_PROVIDER_MODE=disabled

# ---- Natural-use research collection (Phase 6) ----
# Study is the only research data classification. Collection stays off until enabled.
RESEARCH_DATA_PROVENANCE=study
# Approved retention is 45 days, enforced by a daily scheduled cleanup.
RESEARCH_RETENTION_DAYS=45
# Comma-separated approved addresses scripts/create_researcher.py may create
# Researcher accounts for. It grants nothing at login.
RESEARCHER_EMAIL_ALLOWLIST=

# Enable after schema and collection review.
RESEARCH_COLLECTION_ENABLED=false
