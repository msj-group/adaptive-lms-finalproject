# ==========================================================================
# Adaptive English LMS — .gitignore
# ==========================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
!.env.production.example

# ---- Flask / instance data ----
instance/
storage/
uploads/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# ---- Logs ----
logs/
*.log

# ---- Machine learning artifacts ----
ml/artifacts/
ml/models/*.joblib
ml/models/*.pkl
*.joblib
*.pkl
*.h5

# ---- Local database configuration ----
*.sqlite3
*.db

# ---- VS Code ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Windows ----
Thumbs.db
desktop.ini

# ---- Temporary files ----
*.tmp
*.bak
*.swp
tmp/
temp/

# ---- Local AI tooling (do not ignore the whole .claude/ directory) ----
/.claude/settings.local.json

# Private operator copies and database/volume backups are never deployment source.
backups/
exports/
*.sql
*.sql.gz
*.tar
*.tar.gz
