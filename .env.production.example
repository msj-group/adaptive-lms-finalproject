# Template only. Supply real values privately; never commit a populated file.
FLASK_ENV=production
SECRET_KEY=replace-with-a-privately-generated-at-least-32-character-secret
APP_TIMEZONE=Africa/Tripoli
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=youth_centre
DATABASE_USER=youth_centre_runtime
DATABASE_PASSWORD=replace-with-a-private-database-password
# CA certificate for a remote MySQL TLS connection; optional for local/private DB.
DATABASE_SSL_CA=
TRUSTED_HOSTS=learn.example.org
# 0 direct HTTPS; 1 only behind one trusted proxy on a private WSGI listener.
PROXY_TRUSTED_HOPS=1
MATERIAL_STORAGE_ROOT=/srv/youth-centre/private-files
MATERIAL_ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg,gif,webp,mp3,wav,mp4,webm
MATERIAL_MAX_DOCUMENT_BYTES=26214400
MATERIAL_MAX_IMAGE_BYTES=10485760
MATERIAL_MAX_AUDIO_BYTES=52428800
MATERIAL_MAX_VIDEO_BYTES=104857600
PAYMENT_PROVIDER_MODE=disabled
RATELIMIT_STORAGE_URI=memory://
# Keep DEVELOPMENT throughout setup/hosting smoke. Study is a deliberate later step.
RESEARCH_DATA_PROVENANCE=development
RESEARCH_RETENTION_DAYS=15
RESEARCHER_EMAIL_ALLOWLIST=
WSGI_BIND=127.0.0.1:8000
